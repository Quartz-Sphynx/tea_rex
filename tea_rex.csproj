<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>mainTeaRex</RootNamespace>
    <StartupObject>mainTeaRex.Program</StartupObject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>MSB3277</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- BAN THE COMPILER FROM SCANNING THE TEST SUBFOLDER -->
  <ItemGroup>
    <Compile Remove="PlaywrightTests\**" />
    <EmbeddedResource Remove="PlaywrightTests\**" />
    <None Remove="PlaywrightTests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Your Security Sandbox Assembly Reference -->
    <Reference Include="Sandbox">
      <HintPath>libs\Sandbox.dll</HintPath>
    </Reference>
    
    <!-- Your new reusable window launcher assembly reference -->
    <Reference Include="OpenWindow">
      <HintPath>libs\open-window.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Roslyn Compiler package for your sandbox to run -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    
    <!-- 🟢 RE-ACTIVATED THIS: Your main project MUST explicitly have this -->
    <!-- so the compiler actually bundles the Playwright files into bin/Debug -->
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
  </ItemGroup>

</Project>
