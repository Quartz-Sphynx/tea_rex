<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 🟢 UPDATE THIS: Tell .NET you are targeting the native Windows SDK -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>mainTeaRex</RootNamespace>
    <StartupObject>mainTeaRex.Program</StartupObject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>MSB3277</NoWarn>
    
    <!-- 🟢 LEAVE THIS ACTIVE: Tells .NET to unpack the Windows Forms components -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- BAN THE COMPILER FROM SCANNING THE TEST SUBFOLDER -->
  <ItemGroup>
    <Compile Remove="PlaywrightTests\**" />
    <EmbeddedResource Remove="PlaywrightTests\**" />
    <None Remove="PlaywrightTests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Your Security Sandbox Binary -->
    <Reference Include="Sandbox">
      <HintPath>libs\Sandbox.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

</Project>
